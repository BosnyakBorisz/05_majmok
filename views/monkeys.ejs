<%- include('header') %>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Sex</th>
            <th>Species</th>
            <th>Bananas</th>
            <th>Műveletek</th>
        </tr>
    </thead>
    <tbody>
        <% if (locals.monkeys && monkeys.length > 0) { %>
            <% monkeys.forEach(item => { %> 
            <tr>
                <td>
                    <%= item.name %>
                </td>
                <td>
                     <%= item.sex %>
                </td>
                <td>
                     <%= item.species %>
                </td>
                <td>
                    <% 
                        let bananaCount = 0;
                        if (locals.bananas && bananas.length > 0) {
                            bananaCount = bananas.filter(b => b.monkeyId === item.id).length;
                        }
                    %>
                    <%= bananaCount %>
                </td>
                <td>
                    <a href="/monkey/edit/<%= item.id %>" class="btn btn-primary btn-sm m-1">Szerkesztés</a>
                    <a href="/monkey/delete/<%= item.id %>" class="btn btn-danger btn-sm m-1" onclick="return confirm('Biztosan törlöd?')">Törlés</a>
                </td>
            </tr>
            <% }) %>
        <% } else { %>
            <tr>
                <td colspan="5" class="text-center text-muted">Nincsenek majmok az adatbázisban.</td>
            </tr>
        <% } %>
    </tbody>
</table>

<a href="/monkey/new" class="btn btn-primary">Új majom</a>

<%- include('footer') %>
